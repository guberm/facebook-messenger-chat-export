{
  "manifest_version": 3,
  "name": "Facebook Messenger Chat Export",
  "version": "1.10",
  "description": "Export Messenger chat history to JSON, plain text, or self-contained HTML with images",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://www.messenger.com/*", "https://messenger.com/*", "https://www.facebook.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Facebook Messenger Chat Export",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.messenger.com/*", "https://messenger.com/*", "https://www.facebook.com/messages/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
